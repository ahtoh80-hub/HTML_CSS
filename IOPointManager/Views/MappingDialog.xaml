<Window x:Class="IOPointManager.Views.MappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔗 Настройка маппинга Excel" 
        Height="650" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    
    <Window.Resources>
        <Style TargetType="Button" x:Key="DialogButton">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SuccessButton" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="📄 Файл:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center" Foreground="#007ACC" 
                           TextTrimming="CharacterEllipsis"/>
                
                <Button Grid.Column="2" Content="📂 Выбрать" Command="{Binding SelectFileCommand}" 
                        Style="{StaticResource DialogButton}" Padding="10,5"/>
                <Button Grid.Column="3" Content="🔍 Анализ" Command="{Binding AnalyzeCommand}" 
                        Style="{StaticResource DialogButton}" Padding="10,5"
                        IsEnabled="{Binding IsFileSelected}"/>
                <Button Grid.Column="4" Content="⟳ Автодетект" Command="{Binding AutoDetectCommand}" 
                        Style="{StaticResource SuccessButton}" Padding="10,5"
                        IsEnabled="{Binding IsFileSelected}"/>
            </Grid>
        </Border>

        <!-- Центральная панель -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: Поля IOPoint -->
            <Border Grid.Column="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📋 Поля IOPoint" FontWeight="Bold" FontSize="14" 
                               Padding="5" Background="#2C3E50" Foreground="White"/>
                    <ListBox x:Name="IOPointFieldsList" 
                             ItemsSource="{Binding IOPointFields}"
                             SelectedItem="{Binding SelectedIOPointField}"
                             Height="400">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#666666"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Кнопки управления -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10">
                <Button Content="→" Command="{Binding BindCommand}" 
                        Style="{StaticResource DialogButton}" 
                        Width="50" Height="50" FontSize="24" Margin="5"
                        ToolTip="Привязать выбранное поле к колонке"/>
                <Button Content="←" Command="{Binding UnbindCommand}" 
                        Style="{StaticResource DialogButton}" 
                        Width="50" Height="50" FontSize="24" Margin="5"
                        ToolTip="Отвязать выбранное поле"/>
                <Button Content="⟳" Command="{Binding AutoDetectCommand}" 
                        Style="{StaticResource SuccessButton}" 
                        Width="50" Height="50" FontSize="20" Margin="5"
                        ToolTip="Автоматическое обнаружение маппинга"/>
                <Button Content="🔗" Command="{Binding AutoBindCommand}" 
                        Style="{StaticResource SuccessButton}" 
                        Width="50" Height="50" FontSize="20" Margin="5"
                        ToolTip="Авто-привязка по имени колонок"/>
            </StackPanel>

            <!-- Правая колонка: Колонки Excel -->
            <Border Grid.Column="2" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📊 Колонки Excel" FontWeight="Bold" FontSize="14" 
                               Padding="5" Background="#2C3E50" Foreground="White"/>
                    <ListBox x:Name="ExcelColumnsList" 
                             ItemsSource="{Binding ExcelColumns}"
                             SelectedItem="{Binding SelectedExcelColumn}"
                             Height="400">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="{Binding DataType}" FontSize="11" Foreground="#666666"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Начало:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StartRow}" Width="60" 
                         VerticalContentAlignment="Center" Margin="0,0,15,5"/>
                
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Конец:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EndRow}" Width="60" 
                         VerticalContentAlignment="Center" Margin="0,0,15,5"/>
                
                <TextBlock Grid.Row="0" Grid.Column="4" Text="(пусто = до конца)" VerticalAlignment="Center" Foreground="#888888" FontSize="11" Margin="0,0,0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Шаблон:" VerticalAlignment="Center" Margin="0,5,5,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" 
                         Text="{Binding TemplateName}" VerticalContentAlignment="Center"
                         Margin="0,5,10,5" ToolTip="Имя для сохранения шаблона маппинга"/>

                <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📥 Применить" Command="{Binding ApplyMappingCommand}" 
                            Style="{StaticResource SuccessButton}" Padding="20,8"
                            IsEnabled="{Binding CanApply}"/>
                    <Button Content="💾 Сохранить" Command="{Binding SaveTemplateCommand}" 
                            Style="{StaticResource DialogButton}" Padding="15,8"/>
                    <Button Content="📂 Загрузить" Command="{Binding LoadTemplateCommand}" 
                            Style="{StaticResource DialogButton}" Padding="15,8"/>
                    <Button Content="❌ Отмена" Command="{Binding CancelCommand}" 
                            Style="{StaticResource DialogButton}" Background="#999999"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Список привязок -->
        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="1" 
                Padding="10" Margin="0,5,0,0" MaxHeight="80" Grid.RowSpan="2" VerticalAlignment="Bottom">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="🔗 Привязки:" FontWeight="Bold" 
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ListBox ItemsSource="{Binding Bindings}" 
                         DisplayMemberPath="DisplayName"
                         Background="#F0F0F0"
                         BorderThickness="0"
                         FontSize="11"
                         VerticalAlignment="Center">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>