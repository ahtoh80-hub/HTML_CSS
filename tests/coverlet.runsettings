<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!--
            The sources under test are compiled into the test assemblies (the WinForms projects
            cannot be referenced from a cross-platform test project), so the test assembly itself
            has to be instrumented.
          -->
          <IncludeTestAssembly>true</IncludeTestAssembly>
          <ExcludeByFile>**/*Tests.cs,**/TempWorkbook.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
