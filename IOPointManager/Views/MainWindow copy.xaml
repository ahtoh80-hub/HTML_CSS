<Window x:Class="IOPointManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IOPoint Manager - Управление точками ввода-вывода" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Window.Resources>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#D32F2F"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B71C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SuccessButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsImportValid}" Value="False">
                    <Setter Property="Background" Value="#FFE0E0"/>
                    <Setter Property="ToolTip" Value="{Binding ImportError}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsValid}" Value="False">
                    <Setter Property="Background" Value="#FFD0D0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataQualityScore}" Value="&lt; 70">
                    <Setter Property="Background" Value="#FFF0D0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataQualityScore}" Value="&lt; 50">
                    <Setter Property="Background" Value="#FFE0E0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Fault">
                    <Setter Property="Background" Value="#FFC0C0"/>
                    <Setter Property="Foreground" Value="#D32F2F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Maintenance">
                    <Setter Property="Background" Value="#FFF8E1"/>
                    <Setter Property="Foreground" Value="#F57C00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Active">
                    <Setter Property="Background" Value="#E8F5E9"/>
                    <Setter Property="Foreground" Value="#2E7D32"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Меню -->
        <Menu DockPanel.Dock="Top" Background="#2C3E50" Foreground="White" Height="28">
            <MenuItem Header="Файл">
                <MenuItem Header="📂 Открыть Excel..." Command="{Binding OpenExcelCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="🗄️ Access..." Command="{Binding AccessCommand}"/>
                <Separator/>
                <MenuItem Header="❌ Выход" Command="{Binding ExitCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Header="➕ Добавить точку" Command="{Binding AddPointCommand}" InputGestureText="Ins"/>
                <MenuItem Header="✏️ Редактировать" Command="{Binding EditPointCommand}" InputGestureText="Enter"/>
                <MenuItem Header="🗑️ Удалить" Command="{Binding DeletePointCommand}" InputGestureText="Del"/>
                <Separator/>
                <MenuItem Header="🔗 Настройка маппинга..." Command="{Binding ShowMappingDialogCommand}"/>
            </MenuItem>
            <MenuItem Header="Сервис">
                <MenuItem Header="✅ Валидация всех точек" Command="{Binding ValidateAllCommand}"/>
                <MenuItem Header="🔧 Проверить уставки" Command="{Binding ValidateAlarmsCommand}"/>
                <Separator/>
                <MenuItem Header="🧹 Очистить журнал" Command="{Binding ClearLogCommand}"/>
            </MenuItem>
            <MenuItem Header="Помощь">
                <MenuItem Header="📖 О программе" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Панель инструментов -->
        <ToolBar DockPanel.Dock="Top" Background="#ECEFF1" Height="40">
            <Button Command="{Binding OpenExcelCommand}" ToolTip="Открыть Excel файл">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📂" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Excel" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding AccessCommand}" ToolTip="Управление Access">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗄️" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Access" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding AddPointCommand}" ToolTip="Добавить точку">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➕" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding EditPointCommand}" ToolTip="Редактировать точку">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✏️" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Редактировать" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding DeletePointCommand}" ToolTip="Удалить точку" Style="{StaticResource DangerButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑️" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding ValidateAllCommand}" ToolTip="Валидация всех точек" Style="{StaticResource SuccessButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✅" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Валидация" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ValidateAlarmsCommand}" ToolTip="Проверка уставок">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔧" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Уставки" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- Панель поиска -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🔍 Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Height="28" VerticalContentAlignment="Center"
                         ToolTip="Поиск по Tag, Service, InstrumentType, Title"/>
                
                <TextBlock Grid.Column="2" Text="Всего:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <TextBlock Grid.Column="3" Text="{Binding TotalCount}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#007ACC"/>
                
                <TextBlock Grid.Column="4" Text="| Отфильтровано:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBlock Grid.Column="5" Text="{Binding FilteredCount}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#4CAF50"/>
            </Grid>
        </Border>

        <!-- Таблица точек -->
        <DataGrid x:Name="PointsDataGrid"
                  ItemsSource="{Binding FilteredPoints}"
                  SelectedItem="{Binding SelectedPoint}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  IsReadOnly="False"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F8F9FA"
                  RowBackground="White"
                  FontSize="12"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HorizontalGridLinesBrush="#E0E0E0"
                  VerticalGridLinesBrush="#E0E0E0"
                  BorderBrush="#DDDDDD"
                  BorderThickness="1"
                  Margin="0">
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="60"/>
                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="150" FontWeight="Bold"/>
                <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="200"/>
                <DataGridTextColumn Header="Instrument Type" Binding="{Binding InstrumentType}" Width="150"/>
                
                <DataGridComboBoxColumn Header="System" 
                                        ItemsSource="{Binding SystemTypes}"
                                        SelectedItemBinding="{Binding System}"
                                        Width="80"/>
                <DataGridComboBoxColumn Header="Status" 
                                        ItemsSource="{Binding StatusTypes}"
                                        SelectedItemBinding="{Binding Status}"
                                        Width="120"/>
                
                <DataGridTextColumn Header="Качество" Binding="{Binding DataQualityScore}" Width="70"/>
                <DataGridTextColumn Header="LL2" Binding="{Binding AlarmLL2}" Width="60"/>
                <DataGridTextColumn Header="LL" Binding="{Binding AlarmLL}" Width="60"/>
                <DataGridTextColumn Header="L" Binding="{Binding AlarmL}" Width="60"/>
                <DataGridTextColumn Header="H" Binding="{Binding AlarmH}" Width="60"/>
                <DataGridTextColumn Header="HH" Binding="{Binding AlarmHH}" Width="60"/>
                <DataGridTextColumn Header="HH2" Binding="{Binding AlarmHH2}" Width="60"/>
                <DataGridTextColumn Header="Col1" Binding="{Binding Column1}" Width="80"/>
                <DataGridTextColumn Header="Col2" Binding="{Binding Column2}" Width="80"/>
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAt, StringFormat=dd.MM.yyyy}" Width="90" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Журнал событий -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Height="180" Background="#1A1A1A">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#2C3E50" Padding="8,4">
                    <DockPanel>
                        <TextBlock Text="📋 Журнал событий" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="🧹 Очистить" Command="{Binding ClearLogCommand}" 
                                    Background="Transparent" Foreground="#AAAAAA" BorderThickness="0"
                                    Margin="5,0" FontSize="11" Cursor="Hand"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ListBox x:Name="LogListBox" 
                         ItemsSource="{Binding Logs}" 
                         Background="#1A1A1A"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12"
                         Margin="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" 
                                       Foreground="{Binding Type, Converter={StaticResource LogColorConverter}}"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="5,2"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A2A2A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Border DockPanel.Dock="Bottom" Background="#2C3E50" Height="24" Padding="8,0">
                    <DockPanel>
                        <TextBlock Foreground="#AAAAAA" FontSize="11">
                            <Run Text="Событий:"/>
                            <Run Text="{Binding Logs.Count}" Foreground="White" FontWeight="Bold"/>
                            <Run Text=" | " Foreground="#555555"/>
                            <Run Text="Загружено:"/>
                            <Run Text="{Binding TotalCount}" Foreground="#4CAF50" FontWeight="Bold"/>
                            <Run Text=" точек"/>
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Right" Foreground="#666666" FontSize="11">
                            <Run Text="IOPoint Manager v1.0"/>
                        </TextBlock>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>